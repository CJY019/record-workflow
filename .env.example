# Copy this file to .env and fill in your own credentials.
# Choose a model ID in config.local.yaml as described in README.md.
# OpenAI or a compatible service. Include /v1 when your provider requires it.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional Anthropic Messages API provider.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Optional speaker diarization, after accepting the model's access conditions.
HF_TOKEN=

# Optional Hugging Face mirror. Uncomment and supply a trusted endpoint.
# HF_ENDPOINT=https://your-mirror.example.com
